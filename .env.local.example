# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Server only. Also powers the public catalog (/simulations) and certificate verification (/verify).
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- AI scoring (required) ---
# Model is fixed in code: nvidia/nemotron-3.5-lightning
OPENROUTER_API_KEY=sk-or-v1-...

# --- Public URL (used in certificate QR codes, share links, sitemap) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Privileged signup ---
# Once set, the public demo codes (JOBSIM-HR-2026 / JOBSIM-UNI-2026) stop working.
HR_INVITE_CODE=
COURSES_INVITE_CODE=

# --- Admin ---
# Comma-separated emails that are always treated as platform admins.
ADMIN_EMAILS=
# HMAC secret for signed admin report proofs (falls back to the service role key).
REPORT_PROOF_SECRET=

# --- Premium (optional; off by default — every simulation stays free) ---
NEXT_PUBLIC_PREMIUM_ENABLED=false
# Comma-separated promo codes, e.g. JOBSIM2026
PREMIUM_PROMO_CODES=
# Stripe Checkout (one-time payment per period)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=
# Legacy single price, used when the per-plan prices above are empty
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
